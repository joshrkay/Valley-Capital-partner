---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Cta from '../components/Cta.astro';
import PostCard from '../components/PostCard.astro';
import { getPublishedPosts } from '../lib/posts';

const latest = (await getPublishedPosts()).slice(0, 3);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Valley Capital Partners',
  url: Astro.site?.href,
  logo: new URL('/apple-touch-icon.png', Astro.site).href,
  description: "Valley Capital Partners invests in hospitality, multifamily, and retail real estate, and buys non-performing loans from banks, special servicers, and other lenders.",
};
---
<Base title={"Valley Capital Partners"} description={"Valley Capital Partners invests in hospitality, multifamily, and retail real estate, and buys non-performing loans from banks, special servicers, and other lenders."} clips="home" jsonLd={jsonLd}>
<main id="main">
<section class="hero home" data-bg="hero" data-op=".34"><div class="wrap">
  <div class="hero-copy"><p class="eyebrow">Real estate investors</p>
    <h1>We invest in<br><em>hospitality, multifamily,</em><br>and retail.</h1>
    <p>Valley Capital Partners buys real estate and the loans secured by it. We continue to buy non-performing notes from banks, special servicers, and other lenders, and these three sectors are our focus.</p>
    <div class="hero-actions"><a class="btn btn-light arrow" href="/banks/">For banks</a><a class="btn btn-ghost" href="/receivers/">For receivers and counsel</a></div></div>
  </div>
</section>

<section class="section" id="focus"><div class="wrap">
  <div class="head"><p class="eyebrow">What we invest in</p>
    <h2>Three property types, <em>and the loans behind them.</em></h2>
    <p>We buy properties, and we buy the loans secured by them, including loans that are past due or have matured.</p></div>
  <div class="grid3">
    <div><span class="mono">01</span><h3>Hospitality</h3><p>Hotels and the loans secured by them, branded or independent. The Library, the blog, and the underwriting page cover this sector in depth.</p></div>
    <div><span class="mono">02</span><h3>Multifamily</h3><p>Apartment properties and the loans secured by them.</p></div>
    <div><span class="mono">03</span><h3>Retail</h3><p>Retail properties and the loans secured by them.</p></div>
  </div>
</div></section>

<section class="section alt" id="who"><div class="wrap">
  <div class="head"><p class="eyebrow">Who we work with on hotel loans</p>
    <h2>Counterparties on <em>every side</em> of a troubled hotel loan.</h2></div>
  <div class="rows">
    <article class="row">
      <div class="row-main">
        <h3>Community and regional banks</h3>
        <p>Credit officers and special assets teams with a hotel loan that is past due, matured, or classified.</p>
        <a class="more arrow" href="/banks/">For banks</a></div>
      <div class="row-list"><p class="mono">Highlights</p>
        <ul><li>Past due, non-accrual, matured, or in forbearance</li><li>Whole loans, participation interests, and hotels the bank already owns</li><li>We do not contact the borrower, guarantors, the brand, or hotel staff without the bank's consent</li><li>Six steps from a confidentiality agreement to funds wired</li></ul></div>
    </article>
    <article class="row">
      <div class="row-main">
        <h3>Receivers and creditors' rights counsel</h3>
        <p>Court-appointed receivers operating a hotel, and the attorneys who represent its lender.</p>
        <a class="more arrow" href="/receivers/">For receivers</a></div>
      <div class="row-list"><p class="mono">Highlights</p>
        <ul><li>Purchase agreements written for a sale order</li><li>Initial bidder under court-approved overbid procedures</li><li>Franchise, management, licenses, bookings, staff, and taxes handled so the hotel does not miss a night</li><li>We purchase the note with the receivership in place</li></ul></div>
    </article>
    <article class="row">
      <div class="row-main">
        <h3>Special servicers</h3>
        <p>Asset managers resolving a securitized hotel loan through a note sale or a sale of the property.</p>
        <a class="more arrow" href="/servicers/">For special servicers</a></div>
      <div class="row-list"><p class="mono">Highlights</p>
        <ul><li>Non-performing notes, loans in receivership, and lender-owned hotels</li><li>No financing contingency</li><li>We sign the seller's form of loan sale agreement, as-is</li><li>Proof of funds provided with the bid</li></ul></div>
    </article>
    <article class="row">
      <div class="row-main">
        <h3>Hotel owners</h3>
        <p>Borrowers who have negotiated a discounted payoff, or want to, and need the capital to complete it.</p>
        <a class="more arrow" href="/borrowers/">For owners</a></div>
      <div class="row-list"><p class="mono">Highlights</p>
        <ul><li>When a loan is sold, the loan documents stay the same</li><li>You hear from a principal of the firm</li><li>A modification, a payoff figure, or a negotiated transfer, put in writing</li><li>We prefer agreement: negotiated outcomes are faster and cost both sides less</li></ul></div>
    </article>
  </div>
</div></section>

<section class="story" data-bg="hero" data-op=".24"><div class="wrap">
  <p class="eyebrow">01 &mdash; The business</p>
  <h2>A hotel is a business <em>that never closes.</em></h2>
  <p>Every night it reprices its rooms, staffs its front desk, and answers to a brand it does not own.</p>
  <dl class="beat-facts">
    <div><dt>The brand</dt><dd>A franchise agreement ties the hotel to a flag, a reservation system, and the brand's quality standards.</dd></div>
    <div><dt>The license</dt><dd>A liquor license is usually in the owner's name, and the rules for moving it differ by state.</dd></div>
    <div><dt>The taxes</dt><dd>Occupancy and sales taxes are collected for the government, and they have to stay current.</dd></div>
  </dl>
  <a class="more arrow" href="/library/franchise/">The franchise when a hotel loan is sold</a></div>
</section>

<section class="story" data-bg="default" data-op=".26"><div class="wrap">
  <p class="eyebrow">02 &mdash; The default</p>
  <h2>Until the loan behind it <em>stops performing.</em></h2>
  <p>Renovations stall. The franchise comes under threat. Staff and bookings begin to leave.</p>
  <dl class="beat-facts">
    <div><dt>The renovations</dt><dd>The brand's required improvement plan goes unfunded, and the cost, the lost rooms, and the delay all reduce what the hotel is worth.</dd></div>
    <div><dt>The flag</dt><dd>If the brand terminates, the hotel loses the reservation system and loyalty program that supply much of its demand.</dd></div>
    <div><dt>The people</dt><dd>A closed hotel loses its staff, its bookings, and often its flag, so delay costs a hotel more than most property.</dd></div>
  </dl>
  <a class="more arrow" href="/library/pip/">Pricing an unfunded improvement plan</a></div>
</section>

<section class="story" data-bg="lender" data-op=".26"><div class="wrap">
  <p class="eyebrow">03 &mdash; The lender</p>
  <h2>The lender is left with a business <em>it never meant to run.</em></h2>
  <p>A receiver, a liquor license, a payroll, and a foreclosure that can take years.</p>
  <dl class="beat-facts">
    <div><dt>Extend</dt><dd>Keeps the customer and defers the loss, but the loan stays classified and the same decision comes back later.</dd></div>
    <div><dt>Foreclose</dt><dd>Can produce the highest recovery on paper. It takes the longest, and the lender ends up owning an operating business.</dd></div>
    <div><dt>Sell the loan</dt><dd>Fixes the recovery on a known date. The price is lower than a successful workout might yield, and the lender is finished.</dd></div>
  </dl>
  <a class="more arrow" href="/library/choices/">Extend, sell, or foreclose</a></div>
</section>

<section class="story" data-bg="purchase" data-op=".30"><div class="wrap">
  <p class="eyebrow">04 &mdash; The purchase</p>
  <h2>We buy <em>the loan.</em></h2>
  <p>The lender is paid at closing. The hotel stays open. We work the loan through to a resolution.</p>
  <dl class="beat-facts">
    <div><dt>The lender</dt><dd>Paid at closing, with no legal budget, no protective advances, and no hotel to run.</dd></div>
    <div><dt>The hotel</dt><dd>Stays open. Franchise, management, licenses, bookings, staff, and taxes carry on without a gap.</dd></div>
    <div><dt>The loan</dt><dd>Before bidding we read the comfort letter for its assignment terms and, with the seller's consent, ask the brand to confirm the franchise's standing.</dd></div>
  </dl>
  <div class="hero-actions"><a class="btn btn-light arrow" href="/banks/">For banks</a><a class="btn btn-ghost" href="/receivers/">For receivers and counsel</a></div></div>
</section>

<section class="section" id="why"><div class="wrap">
  <div class="head"><p class="eyebrow">Why hotels</p>
    <h2>A hotel loan is a loan on <em>an operating business.</em></h2>
    <p>A hotel reprices its rooms every night, depends on a brand it does not own, and loses value quickly once it closes. When the loan behind it defaults, the lender inherits questions most real estate lenders never have to answer.</p></div>
  <div class="intro" style="grid-template-columns:1fr">
    <p style="font-size:19px;color:var(--soft);max-width:760px">On a hotel loan, we underwrite the operation along with the real estate, and we price the loan with the franchise, the required renovations, and the unpaid taxes already accounted for.</p>
  </div>
  <div class="panel">
    <div>
      <svg viewBox="0 0 150 84" aria-hidden="true"><path d="M30 12v62M30 14h58l-10 14 10 14H30"/><circle cx="118" cy="62" r="5"/><path d="M118 40v12"/></svg>
      <span class="mono">01</span><h3>The franchise</h3>
      <p>Whether the flag survives a default, and whether the lender's rights with the brand pass to a buyer of the loan.</p></div>
    <div>
      <svg viewBox="0 0 150 84" aria-hidden="true"><path d="M20 16h86M20 38h86M20 60h58"/><path d="M114 14l6 6 12-14M114 36l6 6 12-14"/><circle cx="123" cy="62" r="4"/></svg>
      <span class="mono">02</span><h3>The improvement plan</h3>
      <p>What the brand requires, what it costs, and who will fund it.</p></div>
    <div>
      <svg viewBox="0 0 150 84" aria-hidden="true"><rect x="22" y="14" width="62" height="58" rx="2"/><path d="M34 28h12M56 28h12M34 44h12M56 44h12M34 60h12M56 60h12"/><path d="M96 72V40h32v32"/></svg>
      <span class="mono">03</span><h3>The operation</h3>
      <p>Staff, licenses, taxes, and bookings that have to continue without a gap.</p></div>
  </div>
</div></section>

<section class="section alt"><div class="wrap">
  <div class="head"><p class="eyebrow">Situations</p><h2>The hotel loans <em>we are asked to look at.</em></h2></div>
  <div class="grid3">
    <div><span class="mono">01</span><h3>Unfunded improvement plan</h3><p>The brand has required renovations the owner cannot pay for, and the franchise is at risk.</p></div>
    <div><span class="mono">02</span><h3>Franchise default</h3><p>The brand has issued a default or termination notice for unpaid fees or failed inspections.</p></div>
    <div><span class="mono">03</span><h3>Maturity default</h3><p>The hotel is operating, the loan has matured, and a refinance will not cover the balance.</p></div>
    <div><span class="mono">04</span><h3>Payment default</h3><p>Revenue has fallen below what the hotel needs to cover debt service.</p></div>
    <div><span class="mono">05</span><h3>Receivership</h3><p>A receiver is operating the hotel while the lender decides between a note sale and foreclosure.</p></div>
    <div><span class="mono">06</span><h3>Closed or lender-owned hotel</h3><p>The hotel has gone dark, or the lender has taken title and wants to sell.</p></div>
  </div>
</div></section>

<section class="section" id="where"><div class="wrap">
  <div class="head"><p class="eyebrow">Where we step in</p><h2>The course of <em>a defaulted hotel loan.</em></h2>
    <p>A lender can sell at any stage. The earlier the sale, the less time and cost it carries.</p></div>
  <div class="tl">
    <div class="step"><h3>Default</h3><p>A payment is missed or the loan matures unpaid.</p></div>
    <div class="step"><h3>Forbearance</h3><p>Lender and owner try to agree on new terms.</p></div>
    <div class="step"><h3>Receivership</h3><p>A court appoints a receiver to operate the hotel.</p></div>
    <div class="step"><h3>Foreclosure</h3><p>The lender enforces its lien on the property.</p></div>
    <div class="step"><h3>Lender-owned</h3><p>The lender holds title and runs the hotel.</p></div>
    <div class="step"><h3>Sale</h3><p>The hotel passes to a new owner.</p></div>
  </div>
  <div class="ranges">
    <div class="r1"><strong>We buy the loan</strong><span>At any point before the lender takes title</span></div>
    <div class="r2"><strong>We buy the hotel</strong><span>Through a receiver's sale, at foreclosure, or from the lender</span></div>
  </div>
</div></section>

<section class="section alt" id="capital"><div class="wrap cap">
  <div><p class="eyebrow">Capital</p><h2>Funded by a private family office and <em>committed firm capital.</em></h2></div>
  <div><p class="lead">Our acquisitions are funded by a private family office, whose principal has a founding background in online travel and hospitality, and by the firm's own committed capital.</p>
    <ul><li>No third-party financing is needed to close</li><li>The capital source is identified to sellers under a confidentiality agreement</li><li>Proof of funds is provided with a bid</li></ul>
    <a class="btn btn-light arrow" href="/firm/">About the firm</a></div>
</div></section>

<section class="section"><div class="wrap">
  <div class="head"><p class="eyebrow">Library</p><h2>Technical notes on <em>hotel loan workouts.</em></h2></div>
  <div class="cards">
    <a class="card" href="/library/franchise/"><span class="mono">Note 01</span><h3>The franchise when a hotel loan is sold</h3><p>What a comfort letter gives the lender, and whether a buyer of the loan inherits it.</p><span class="go">Read</span></a>
    <a class="card" href="/library/pip/"><span class="mono">Note 02</span><h3>Pricing an unfunded improvement plan</h3><p>The three ways required renovations reduce the value of the collateral.</p><span class="go">Read</span></a>
    <a class="card" href="/library/receivership/"><span class="mono">Note 03</span><h3>Keeping a hotel open through receivership</h3><p>The six points that decide whether a hotel keeps operating.</p><span class="go">Read</span></a>
  </div>
</div></section>
  {latest.length > 0 && (
    <section class="section alt">
      <div class="wrap">
        <div class="head"><p class="eyebrow">Blog</p><h2>Recent <em>writing.</em></h2></div>
        <div class="cards">{latest.map((p) => <PostCard post={p} />)}</div>
        <p><a class="more arrow" href="/blog/">All posts</a></p>
      </div>
    </section>
  )}
</main>
<Cta title={"Have a loan or a property you would like us to review?"} text={"Send a summary of the loan and the property. We reply with an indication of interest or a clear decline."} label={"Contact us"} />
</Base>
