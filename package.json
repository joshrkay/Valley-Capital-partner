{
  "name": "valley-capital-partners-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Website for Valley Capital Partners, a buyer of non-performing hotel loans.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "fetch-video": "node scripts/fetch-video.mjs",
    "build": "node scripts/fetch-video.mjs && astro build",
    "preview": "astro preview",
    "check": "python3 scripts/check_site.py",
    "desk:listen": "node scripts/desk/listen.mjs",
    "desk:check": "node scripts/desk/listen.mjs --check",
    "desk:test": "node --test scripts/desk/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^6.4.8"
  }
}
