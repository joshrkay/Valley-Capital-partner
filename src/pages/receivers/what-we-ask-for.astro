---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Cta from '../../components/Cta.astro';
import SectionNav from '../../components/SectionNav.astro';
---
<Base title={"What We Ask for from a Receiver or Counsel"} description={"The information that lets us respond to a receiver or lender's counsel: the case, the hotel, and the documents that go with a receivership."}>
  <Hero eyebrow={"For receivers and counsel"} title={"Information that lets us respond."} lead={"We respond to receivers and counsel directly. Send what you have, and tell us what is missing."} />
  <SectionNav section="receivers" />
  <main id="main">
<section class="section"><div class="wrap">
      <div class="head"><p class="eyebrow">What we ask for</p><h2>The case, and the hotel.</h2></div>
      <div class="cells two">
        <div><h3>The case</h3><ul><li>Order of appointment</li><li>Receiver's reports to the court</li><li>Any sale procedures already approved</li><li>Status of the foreclosure action</li></ul></div>
        <div><h3>The hotel</h3><ul><li>Operating statements under the receiver</li><li>Monthly performance reports</li><li>Correspondence with the brand</li><li>List of capital needs</li></ul></div>
      </div>
    </div></section>

    <section class="section alt"><div class="wrap">
      <div class="head"><p class="eyebrow">Also useful</p><h2>The documents that fill in the picture.</h2></div>
      <div class="cells">
        <div><h3>Franchise and management</h3><ul><li>Franchise agreement and comfort letter</li><li>Default and termination notices from the brand</li><li>Improvement plan and latest quality inspection</li><li>Management agreement</li></ul></div>
        <div><h3>Operations</h3><ul><li>Operating statements, with the trailing twelve months</li><li>Occupancy and sales tax filings</li><li>Liquor license and operating permits</li><li>Group bookings and advance deposits</li></ul></div>
        <div><h3>Property and proceedings</h3><ul><li>Latest appraisal, condition report, and environmental report</li><li>Ground lease, if any</li><li>Pending litigation and bankruptcy filings</li></ul></div>
      </div>
    </div></section>

    <section class="section"><div class="wrap intro">
      <div><p class="eyebrow">How to send it</p><h2>Write to us, and say what you have.</h2></div>
      <dl class="pillars">
        <div><dt>Write to acquisitions</dt><dd><a class="more arrow" href="mailto:acquisitions@valleycapitalpartner.com">acquisitions@valleycapitalpartner.com</a>, or use the <a class="more arrow" href="/contact/">contact page</a>.</dd></div>
        <div><dt>You do not need everything</dt><dd>Tell us who you are and, in a sentence or two, about the hotel and the case. A principal will reply.</dd></div>
        <div><dt>It stays confidential</dt><dd>Information you send is used only to evaluate the hotel or the loan. We do not contact borrowers, guarantors, brands, or hotel staff without the consent of the party that sent it.</dd></div>
      </dl>
    </div></section>

    <section class="section alt"><div class="wrap"><div class="head"><p class="eyebrow">Related reading</p></div><ul class="toc"><li><a href="/library/checklist/">Hotel loan diligence checklist <span>Library</span></a></li><li><a href="/receivers/buying-from-a-receiver/">Buying a hotel from a receiver <span>Receivers</span></a></li><li><a href="/contact/">Contact the firm <span>Contact</span></a></li></ul></div></section>
  </main>
  <Cta title={"Tell us about the hotel and the case."} text={"We respond to receivers and counsel directly."} label={"Discuss a receivership"} />
</Base>
