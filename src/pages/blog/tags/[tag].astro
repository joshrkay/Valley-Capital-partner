---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Hero from '../../../components/Hero.astro';
import Cta from '../../../components/Cta.astro';
import { tagSlug } from '../../../lib/tags';
import PostCard from '../../../components/PostCard.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => (import.meta.env.PROD ? !data.draft : true));
  const labels = new Map<string, string>();
  for (const p of posts) for (const t of p.data.tags) labels.set(tagSlug(t), t);
  return [...labels].map(([slug, label]) => ({
    params: { tag: slug },
    props: {
      label,
      posts: posts.filter((p) => p.data.tags.some((t) => tagSlug(t) === slug)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
    },
  }));
}

const { label, posts } = Astro.props;
---
<Base title={`${label} | Blog`} description={`Posts tagged ${label}.`}>
  <Hero eyebrow="Blog topic" title={label} lead={`${posts.length} ${posts.length === 1 ? 'post' : 'posts'} tagged ${label}.`} />
  <main id="main">
    <section class="section">
      <div class="wrap">
        <div class="cards">{posts.map((post) => <PostCard post={post} />)}</div>
        <p><a class="more arrow" href="/blog/">All posts</a></p>
      </div>
    </section>
  </main>
  <Cta title="Have a hotel loan you would like us to review?" text="Send a summary of the loan and the property. We reply with an indication of interest or a clear decline." />
</Base>
