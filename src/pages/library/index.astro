---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Cta from '../../components/Cta.astro';

const notes = (await getCollection('library', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Library" description="Technical notes on hotel loan workouts from Valley Capital Partners.">
  <Hero eyebrow="Library" title="Technical notes on hotel loan workouts." lead="Written for credit officers, asset managers, receivers, and counsel who are dealing with a hotel loan in default." />
  <main id="main">
    <section class="section">
      <div class="wrap">
        <ul class="toc">
          {notes.map((n) => <li><a href={`/library/${n.id}/`}>{n.data.title} <span>{n.data.topic}</span></a></li>)}
        </ul>
        <p class="fine">These notes are general commentary and are not legal, accounting, or regulatory advice. Franchise and receivership practice varies by brand and by state.</p>
      </div>
    </section>
  </main>
  <Cta title="Have a hotel loan you would like us to review?" text="Send a summary of the loan and the property. We reply with an indication of interest or a clear decline." />
</Base>
