---
// [address, label, addresses that count as "this section"]
const NAV: [string, string, string[]][] = [
  ['/banks/', 'Banks', ['/banks/']],
  ['/receivers/', 'Receivers', ['/receivers/']],
  ['/servicers/', 'Special servicers', ['/servicers/']],
  ['/underwriting/', 'Underwriting', ['/underwriting/']],
  ['/resources/', 'Resources', ['/resources/', '/library/', '/blog/', '/glossary/', '/faq/']],
  ['/firm/', 'Firm', ['/firm/']],
];
const path = Astro.url.pathname;
const current = (match: string[]) => match.some((m) => path.startsWith(m));
---
<a class="skip" href="#main">Skip to content</a>
<header class="bar" id="bar">
  <div class="wrap">
    <a class="brand" href="/" aria-label="Valley Capital Partners, home">Valley Capital Partners<i>.</i></a>
    <nav class="nav" aria-label="Primary">
      {NAV.map(([href, label, match]) => <a href={href} aria-current={current(match) ? 'page' : undefined}>{label}</a>)}
    </nav>
    <div class="bar-end">
      <a class="btn btn-ink" href="/contact/">Contact</a>
      <details class="menu">
        <summary>Menu</summary>
        <div>
          {NAV.map(([href, label]) => <a href={href}>{label}</a>)}
          <a href="/contact/">Contact</a>
        </div>
      </details>
    </div>
  </div>
</header>
