---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Cta from '../components/Cta.astro';
---
<Base title={"For Special Servicers"} description={"Valley Capital Partners bids on non-performing hotel loans and lender-owned hotels offered by special servicers."}>
<Hero eyebrow={"For special servicers"} title={"A qualified bidder for hotel loans."} lead={"We bid on non-performing hotel loans and lender-owned hotels, offered singly or in pools, directly or through a loan sale advisor."}>
  <a class="btn btn-light arrow" href="/contact/">Add us to a bidder list</a>
</Hero>
<main id="main">
<section class="section"><div class="wrap">
  <div class="head"><p class="eyebrow">How we bid</p><h2>Terms a servicer can rely on.</h2></div>
  <dl class="spec">
    <div><dt>Financing</dt><dd>No financing contingency. Our acquisitions are funded by a private family office and committed firm capital.</dd></div>
    <div><dt>Diligence</dt><dd>Completed before the bid date. Our final bid is not subject to further review.</dd></div>
    <div><dt>Documents</dt><dd>We sign the seller's form of loan sale agreement, as-is, with the representations it offers.</dd></div>
    <div><dt>Deposit</dt><dd>Posted on signing.</dd></div>
    <div><dt>Closing</dt><dd>On the seller's schedule.</dd></div>
    <div><dt>Non-affiliation</dt><dd>We certify that we have no affiliation with the borrower, guarantor, or sponsor.</dd></div>
    <div><dt>Proof of funds</dt><dd>Provided with the bid.</dd></div>
    <div><dt>Authority</dt><dd>The person who submits the bid has authority to close it.</dd></div>
  </dl>
</div></section>

<section class="section alt"><div class="wrap">
  <div class="head"><p class="eyebrow">What we bid on</p><h2>Hotel assets in special servicing.</h2></div>
  <div class="cells">
    <div><h3>Non-performing notes</h3><p>Loans in payment or maturity default, before or after a foreclosure filing.</p></div>
    <div><h3>Loans in receivership</h3><p>Notes sold with a receiver in place and the hotel operating.</p></div>
    <div><h3>Lender-owned hotels</h3><p>Properties the trust has taken title to, open or closed.</p></div>
  </div>
</div></section>

<section class="section"><div class="wrap">
  <div class="head"><p class="eyebrow">Bid package</p><h2>What we review.</h2></div>
  <div class="cells two">
    <div><h3>Loan and servicing</h3><ul><li>Loan documents and assignments</li><li>Servicing history and outstanding advances</li><li>Latest appraisal</li><li>Litigation and bankruptcy status</li></ul></div>
    <div><h3>Hotel</h3><ul><li>Franchise agreement and comfort letter</li><li>Improvement plan and inspection results</li><li>Trailing performance reports and operating statements</li><li>Receiver reports and tax status</li></ul></div>
  </div>
</div></section>
</main>
<Cta title={"Include us in your next hotel offering."} text={"Send the offering or have your advisor add us to the distribution."} label={"Contact us"} />
</Base>
