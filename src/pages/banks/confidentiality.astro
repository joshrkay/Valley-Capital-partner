---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Cta from '../../components/Cta.astro';
import SectionNav from '../../components/SectionNav.astro';
---
<Base title={"Confidentiality in a Hotel Loan Sale"} description={"How we handle a bank's information in a hotel loan sale: an agreement first, use limited to evaluating the purchase, and no contact with anyone without consent."}>
  <Hero eyebrow={"For banks"} title={"How we handle a bank's information."} lead={"A loan sale involves a customer relationship and information the bank is obliged to protect."} />
  <SectionNav section="banks" />
  <main id="main">
<section class="feature"><div class="wrap">
      <div><p class="eyebrow">Confidentiality</p><h2>Three commitments.</h2></div>
      <div><p class="lead">A loan sale involves a customer relationship and information the bank is obliged to protect.</p>
        <ul><li>Loan information is used only to evaluate the purchase</li><li>We do not contact the borrower, guarantors, the brand, or hotel staff without the bank's consent</li><li>If we do not proceed, we return or destroy the file on request</li></ul></div>
    </div></section>

    <section class="section"><div class="wrap">
      <div class="head"><p class="eyebrow">In practice</p><h2>What that means at each stage.</h2></div>
      <div class="cells">
        <div><h3>Before anything is shared</h3><p>We sign your confidentiality agreement or provide ours before any loan-level information is shared.</p></div>
        <div><h3>While we evaluate</h3><p>The information is used only to evaluate the loan. The existence of a discussion is confidential, as is everything in the file.</p></div>
        <div><h3>If we do not proceed</h3><p>We return or destroy the file on request. A conversation and an indicative price carry no obligation to sell.</p></div>
      </div>
    </div></section>

    <section class="section alt"><div class="wrap">
      <div class="head"><p class="eyebrow">What we do not do</p><h2>No contact without the bank's consent.</h2></div>
      <div class="cells two">
        <div><h3>We do not contact</h3><ul><li>The borrower</li><li>Guarantors</li><li>The franchise brand</li><li>Hotel staff</li></ul></div>
        <div><h3>Unless</h3><ul><li>The bank has consented</li><li>Or, after closing, we have become the holder of the loan and contact the borrower directly with notice of the transfer</li></ul></div>
      </div>
    </div></section>

    <section class="section alt"><div class="wrap"><div class="head"><p class="eyebrow">Related reading</p></div><ul class="toc"><li><a href="/banks/how-a-sale-works/">How a hotel loan sale works <span>Banks</span></a></li><li><a href="/underwriting/">Principles: price once, say no early, keep it confidential <span>Underwriting</span></a></li><li><a href="/contact/">Contact the firm <span>Contact</span></a></li></ul></div></section>
  </main>
  <Cta title={"Discuss a hotel loan in confidence."} text={"A conversation and an indicative price carry no obligation to sell."} label={"Start a conversation"} />
</Base>
