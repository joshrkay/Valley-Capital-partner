---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Cta from '../../components/Cta.astro';
import SectionNav from '../../components/SectionNav.astro';
import { SECTIONS } from '../../lib/sections';
---
<Base title={"For Banks"} description={"Valley Capital Partners buys non-performing hotel loans from community and regional banks."}>
<Hero eyebrow={"For banks"} title={"A buyer for the hotel loan on your problem list."} lead={"We purchase past-due, matured, and classified hotel loans from community and regional banks. The bank receives cash at closing and transfers the loan, the file, and the workout."}>
  <a class="btn btn-light arrow" href="/contact/">Discuss a loan in confidence</a>
</Hero>
<SectionNav section="banks" />
<main id="main">
<section class="section"><div class="wrap intro">
  <div><p class="eyebrow">Why banks sell hotel loans</p><h2>A hotel workout asks more of a lender than most banks are staffed for.</h2>
    <div class="body"><p>Enforcing a hotel loan means dealing with a franchisor, a management company, a liquor authority, and a payroll, usually through a receiver, for as long as foreclosure takes in that state.</p>
    <p>A loan sale ends the bank's involvement on a date it chooses.</p></div></div>
  <dl class="pillars">
    <div><dt>The workout is consuming staff time</dt><dd>One hotel loan can occupy a credit officer for a year or more.</dd></div>
    <div><dt>The hotel needs renovations nobody will fund</dt><dd>The brand's improvement plan is overdue, and the bank does not want to advance the cost.</dd></div>
    <div><dt>The bank does not want to own a hotel</dt><dd>Taking title means operating a business the bank has no licence, staff, or wish to run.</dd></div>
    <div><dt>The borrower is a customer</dt><dd>A sale lets someone else do the enforcing.</dd></div>
  </dl>
</div></section>

<section class="section alt"><div class="wrap">
  <div class="head"><p class="eyebrow">What we buy</p><h2>Acquisition criteria.</h2></div>
  <dl class="spec">
    <div><dt>Loan status</dt><dd>Past due, non-accrual, matured, or in forbearance. Loans in foreclosure, receivership, or borrower bankruptcy are eligible.</dd></div>
    <div><dt>Collateral</dt><dd>Hotels: limited-service, select-service, extended-stay, and full-service, branded or independent.</dd></div>
    <div><dt>Lien position</dt><dd>First mortgages and first deeds of trust, with the related security interest in furniture, equipment, and accounts.</dd></div>
    <div><dt>Interest acquired</dt><dd>Whole loans, participation interests, and hotels the bank already owns.</dd></div>
    <div><dt>Guaranteed loans</dt><dd>We review government-guaranteed hotel loans and work within the agency's consent requirements for a sale.</dd></div>
    <div><dt>Transaction size</dt><dd>Single loans and small pools.</dd></div>
  </dl>
</div></section>

<section class="section"><div class="wrap">
  <div class="head"><p class="eyebrow">Process</p><h2>How a sale works.</h2></div>
  <ol class="steps">
    <li><h3>Confidentiality agreement</h3><p>We sign yours or provide ours before any loan-level information is shared.</p></li>
    <li><h3>One-page summary</h3><p>Balance, status, the hotel's brand and room count, and any recent valuation. A full file is not needed yet.</p></li>
    <li><h3>Indicative price</h3><p>We respond with a price and the assumptions behind it, or tell you the loan is not for us.</p></li>
    <li><h3>Due diligence</h3><p>We review the loan file, title, franchise documents, and operating results, and inspect the hotel.</p></li>
    <li><h3>Loan sale agreement</h3><p>A purchase agreement with a fixed price and closing date.</p></li>
    <li><h3>Closing</h3><p>Funds are wired, the note is endorsed, the mortgage is assigned, and the file is transferred.</p></li>
  </ol>
</div></section>

<section class="feature"><div class="wrap">
  <div><p class="eyebrow">Confidentiality</p><h2>How we handle a bank's information.</h2></div>
  <div><p class="lead">A loan sale involves a customer relationship and information the bank is obliged to protect.</p>
    <ul><li>Loan information is used only to evaluate the purchase</li><li>We do not contact the borrower, guarantors, the brand, or hotel staff without the bank's consent</li><li>If we do not proceed, we return or destroy the file on request</li></ul></div>
</div></section>

<section class="section"><div class="wrap">
  <div class="head"><p class="eyebrow">What to send</p><h2>Information that lets us price a hotel loan.</h2></div>
  <div class="cells two">
    <div><h3>For an indication</h3><ul><li>Unpaid principal balance and accrued interest</li><li>Payment status and maturity date</li><li>Hotel name, brand, location, and room count</li><li>Most recent appraisal, if any</li><li>Whether the hotel is open, and who is operating it</li></ul></div>
    <div><h3>For diligence</h3><ul><li>Note, mortgage, assignments, and guaranties</li><li>Franchise agreement, comfort letter, and improvement plan</li><li>Operating statements and performance reports</li><li>Tax, insurance, and licence status</li><li>Default correspondence and any court filings</li></ul></div>
  </div>
</div></section>

<section class="section alt">
  <div class="wrap">
    <div class="head"><p class="eyebrow">In this section</p><h2>Everything a bank needs to know, <em>in one place.</em></h2></div>
    <div class="cards">
      {SECTIONS.banks.pages.slice(1).map((p, i) => (
        <a class="card" href={p.href}><span class="mono num">{String(i + 1).padStart(2, '0')}</span><h3>{p.title}</h3><p>{p.summary}</p><span class="go">Read</span></a>
      ))}
    </div>
  </div>
</section>
</main>
<Cta title={"Discuss a hotel loan in confidence."} text={"A conversation and an indicative price carry no obligation to sell."} label={"Start a conversation"} />
</Base>
