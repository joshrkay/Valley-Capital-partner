---
interface Props {
  faqs: { q: string; a: string }[];
}
const { faqs } = Astro.props;
---
<div class="acc faq">
  {faqs.map(({ q, a }, i) => (
    <details name="faq" open={i === 0}>
      <summary><span class="n">{String(i + 1).padStart(2, '0')}</span><span class="t">{q}</span><span class="pm"></span></summary>
      <div class="body"><p>{a}</p></div>
    </details>
  ))}
</div>
